# AirGradient Go product defaults.

# PayloadCache: store MeasuresAGo (temp/hum, PM, CO2, TVOC/NOx, power) rather
# than the full Measures struct. Go does not use the secondary sensor channels
# (temp_hum_b, pm_b, electrode) in its chart cache.
CONFIG_PAYLOAD_CACHE_TYPE_AGO=y

# ESP32-C5: the GPIO light-sleep reset workaround calls gpio_sleep_sel_en()
# for every GPIO via REGDMA, which stalls indefinitely on this chip during
# early startup before the scheduler is running.  Disable it until the
# underlying IDF issue is resolved.
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n

# BLE (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=21
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# BLE push OTA: larger ATT MTU for throughput.  At MTU 512 the ATT
# Write-Command payload is MTU-3 = 509 bytes, so the phone chunks Data writes
# to <= 509 bytes (the component rejects single Data writes larger than
# CONFIG_AG_OTA_BLE_DATA_MAX_BYTES = 512).  Provision a NimBLE mbuf block large
# enough to hold a full MTU-512 ATT payload without chaining.  (mbuf headroom
# confirmed on HIL — see specs/ota.md.)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=128
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=528

# LP Core (ULP coprocessor) — used to feed the external hardware watchdog
# (GPIO2) during deep sleep so sleep intervals can exceed the watchdog timeout.
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y

# SGP41 gas index algorithm sampling interval
CONFIG_SGP41_INDEX_SAMPLING_INTERVAL_10S=y

# Wi-Fi RX buffers trimmed from IDF defaults (static 10->6, dynamic 16->10)
# to cut the resident Wi-Fi driver heap and reduce fragmentation when Wi-Fi
# runs alongside the Portable BLE data service during attached provisioning.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
